{% extends 'base.html.twig' %}

{% block title %} Ma liste de livres {% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    {% for livre in livres %}
        <div class="livre">
            <h3>{{ livre.titre }}</h3>
            <p><em>{{ livre.auteur.prenom }} {{ livre.auteur.nom }}</em> - {{ livre.annee }}</p>
            <a href="{{ path('app_livre_detail', {id: livre.id}) }}" >En savoir +</a>
        </div>
    {% endfor %}
</div>
{% endblock %}