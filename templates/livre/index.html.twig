{% extends 'base.html.twig' %}

{% block title %} Ma liste de livres {% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
<div style="">
    <div class="example-wrapper">
        {% for livre in livres %}
            <div style="background-color: #f0f0f0; padding: 20px; border-radius: 5px; margin: 20px; color: black; width: 500px">
                <div class="livre">
                    <h3>{{ livre.titre }}</h3>
                    <p><em>{{ livre.auteur.prenom }} {{ livre.auteur.nom }}</em> - {{ livre.annee }}</p>
                    <p><em>{{ livre.genre }}</em></p>
                    <a href="{{ path('app_livre_detail', {id: livre.id}) }}" >Voir le détail</a>
                </div>
            </div>            
        {% endfor %}
    </div>
    <div>
    <a href="{{ path('app_livre_nouveau') }}">Ajouter un livre</a>
    
    </div>
</div>
{% endblock %}