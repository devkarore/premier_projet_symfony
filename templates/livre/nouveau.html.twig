{# templates/livre/nouveau.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouveau Livre{% endblock %}

{% block body %}
<div class="custom-container w-50">
    <div class="livre-detail blurry-bubble">
        <h1>Ajouter un livre</h1>
        <div class="formulaire ">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-12 col-md-6">
                        {{ form_row(form.titre) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_row(form.annee) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        {{ form_row(form.genre) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_row(form.resume) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        {{ form_row(form.auteur) }}
                    </div>
                    {# <div class="col-12 col-md-6">
                        {{ form_row(form.prenom) }}
                    </div> #}
                </div>
                <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
            {{ form_end(form) }}
        </div>
        <a href="{{ path('app_livres') }}">Retour à la liste des livres</a>
    </div>
</div>
{% endblock %}