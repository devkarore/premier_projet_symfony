{% extends 'base.html.twig' %}
{% block title %}
    {{ livreAAfficher.titre }}
{% endblock %}

{% block body %}

    <a href="{{ path('app_livres') }}">Retour à la liste des livres</a>
    <br>
    <div class="livreAAfficher" style="background-color: #f0f0f0; padding: 20px; border-radius: 5px; margin-bottom: 20px; color: black; width: 500px">
        <h3>{{ livreAAfficher.titre }}</h3>
        <a href="{{ path('app_auteur_detail', {id: livreAAfficher.auteur.id}) }}">
            <p><em>{{ livreAAfficher.auteur.prenom }} {{ livreAAfficher.auteur.nom }}</em>
        </a>
         - {{ livreAAfficher.annee }}</p>
        <h5>Résumé du livre :</h5>
        <p>{{ livreAAfficher.resume }}</p>
    </div>
{% endblock %}