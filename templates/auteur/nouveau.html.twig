{# templates/auteur/nouveau.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouvel Auteur{% endblock %}

{% block body %}
<div class="custom-container w-50">
    <div class="livre-detail blurry-bubble">
        <h1>Ajouter un auteur</h1>
        <div class="formulaire ">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-12 col-md-6">
                        {{ form_row(form.nom) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_row(form.prenom) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        {{ form_row(form.nationalite) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_row(form.dateNaissance) }}
                    </div>
                </div>
                {{ form_row(form.biographie) }}
                <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
