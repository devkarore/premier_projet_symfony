{% extends 'base.html.twig' %}

{% block title %} Liste des auteurs {% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    {% for auteur in auteurs %}
        <div class="auteur" style="background-color: #f0f0f0; padding: 20px; border-radius: 5px; margin-bottom: 20px; color: black; width: 300px">
            <h3>{{ auteur.prenom }} {{ auteur.nom }}</h3>
            <a href="{{ path('app_auteur_detail', {id: auteur.id}) }}" >En savoir +</a>
        </div>
    {% endfor %}
</div>
{% endblock %}